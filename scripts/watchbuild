#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" && pwd)"
cd "${SCRIPT_DIR}/.."

DESTINATION="${SILVERAN_WATCHOS_DESTINATION:-platform=watchOS Simulator,id=08EC1854-5E75-4159-B897-0C37B6FAC2CD}"
XCODEBUILD_OPTIONS=(build)
if [[ "${SILVERAN_DISABLE_CODE_SIGNING:-0}" == "1" ]]; then
    XCODEBUILD_OPTIONS=(CODE_SIGNING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO build)
fi

xcodebuild -project Silveran.xcodeproj \
    -scheme "Silveran Reader (watchOS)" \
    -configuration Debug \
    -destination "${DESTINATION}" \
    -derivedDataPath .buildWatch "${XCODEBUILD_OPTIONS[@]}" | xcbeautify
